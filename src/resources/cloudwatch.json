{
  "resources": {
    "cloudwatch-alarms": {
      "display_name": "CloudWatch Alarms",
      "service": "monitoring",
      "sdk_method": "describe_alarms",
      "sdk_method_params": {},
      "response_path": "alarms",
      "id_field": "AlarmName",
      "name_field": "AlarmName",
      "is_global": false,
      "columns": [
        { "header": "ALARM NAME", "json_path": "AlarmName", "width": 30 },
        { "header": "STATE", "json_path": "StateValue", "width": 18, "color_map": "state" },
        { "header": "METRIC", "json_path": "MetricName", "width": 22 },
        { "header": "NAMESPACE", "json_path": "Namespace", "width": 22 },
        { "header": "THRESHOLD", "json_path": "Threshold", "width": 10 },
        { "header": "PERIOD", "json_path": "Period", "width": 8 },
        { "header": "ACTIONS", "json_path": "ActionsEnabled", "width": 9, "color_map": "bool" }
      ],
      "sub_resources": [],
      "actions": [],
      "api_config": {
        "protocol": "json",
        "service_name": "monitoring",
        "action": "DescribeAlarms",
        "response_root": "/MetricAlarms",
        "pagination": {
          "input_token": "NextToken",
          "output_token": "/NextToken",
          "max_results_param": "MaxRecords",
          "max_results": 100
        }
      },
      "field_mappings": {
        "AlarmName": { "source": "/AlarmName", "default": "-" },
        "AlarmArn": { "source": "/AlarmArn", "default": "-" },
        "StateValue": { "source": "/StateValue", "default": "-" },
        "StateReason": { "source": "/StateReason", "default": "-" },
        "MetricName": { "source": "/MetricName", "default": "-" },
        "Namespace": { "source": "/Namespace", "default": "-" },
        "Threshold": { "source": "/Threshold", "default": "-" },
        "Period": { "source": "/Period", "default": "-" },
        "EvaluationPeriods": { "source": "/EvaluationPeriods", "default": "-" },
        "ComparisonOperator": { "source": "/ComparisonOperator", "default": "-" },
        "ActionsEnabled": { "source": "/ActionsEnabled", "transform": "bool_to_yes_no", "default": "-" },
        "StateUpdatedTimestamp": { "source": "/StateUpdatedTimestamp", "transform": "format_epoch_millis", "default": "-" },
        "AlarmDescription": { "source": "/AlarmDescription", "default": "-" }
      }
    },
    "cloudwatch-log-groups": {
      "display_name": "CloudWatch Log Groups",
      "service": "cloudwatchlogs",
      "sdk_method": "describe_log_groups",
      "sdk_method_params": {},
      "response_path": "log_groups",
      "id_field": "logGroupName",
      "name_field": "logGroupName",
      "is_global": false,
      "columns": [
        { "header": "LOG GROUP NAME", "json_path": "logGroupName", "width": 50 },
        { "header": "STORED BYTES", "json_path": "storedBytes", "width": 15 },
        { "header": "RETENTION (DAYS)", "json_path": "retentionInDays", "width": 18 },
        { "header": "CREATED", "json_path": "creationTime", "width": 25 }
      ],
      "sub_resources": [
        {
          "shortcut": "s",
          "display_name": "Log Streams",
          "resource_key": "cloudwatch-log-streams",
          "parent_id_field": "logGroupName",
          "filter_param": "log_group_name"
        }
      ],
      "actions": [],
      "api_config": {
        "protocol": "json",
        "service_name": "logs",
        "action": "DescribeLogGroups",
        "response_root": "/logGroups",
        "pagination": {
          "input_token": "nextToken",
          "output_token": "/nextToken",
          "max_results_param": "limit",
          "max_results": 50
        }
      },
      "field_mappings": {
        "logGroupName": { "source": "/logGroupName", "default": "-" },
        "logGroupArn": { "source": "/arn", "default": "-" },
        "storedBytes": { "source": "/storedBytes", "default": "0" },
        "retentionInDays": { "source": "/retentionInDays", "default": "Never" },
        "creationTime": { "source": "/creationTime", "default": "-" }
      }
    },
    "cloudwatch-log-streams": {
      "display_name": "Log Streams",
      "service": "cloudwatchlogs",
      "sdk_method": "describe_log_streams",
      "sdk_method_params": {},
      "response_path": "log_streams",
      "id_field": "logStreamName",
      "name_field": "logStreamName",
      "is_global": false,
      "requires_parent": true,
      "columns": [
        { "header": "STREAM NAME", "json_path": "logStreamName", "width": 45 },
        { "header": "LAST EVENT", "json_path": "lastEventTime", "width": 22 },
        { "header": "SIZE", "json_path": "storedBytes", "width": 12 },
        { "header": "FIRST EVENT", "json_path": "firstEventTime", "width": 21 }
      ],
      "sub_resources": [],
      "actions": [
        {
          "key": "t",
          "display_name": "Tail Logs",
          "shortcut": "t",
          "sdk_method": "tail_logs"
        }
      ],
      "api_config": {
        "protocol": "json",
        "service_name": "logs",
        "action": "DescribeLogStreams",
        "response_root": "/logStreams",
        "static_params": {
          "orderBy": "LastEventTime",
          "descending": true
        },
        "param_mapping": {
          "log_group_name": "logGroupName"
        },
        "pagination": {
          "input_token": "nextToken",
          "output_token": "/nextToken",
          "max_results_param": "limit",
          "max_results": 50
        }
      },
      "field_mappings": {
        "logStreamName": { "source": "/logStreamName", "default": "-" },
        "lastEventTime": { "source": "/lastEventTimestamp", "transform": "format_epoch_millis", "default": "-" },
        "firstEventTime": { "source": "/firstEventTimestamp", "transform": "format_epoch_millis", "default": "-" },
        "storedBytes": { "source": "/storedBytes", "transform": "format_bytes", "default": "0" },
        "lastEventTimestamp": { "source": "/lastEventTimestamp", "default": "0" }
      }
    }
  }
}
