{
  "resources": {
    "cloudfront-distributions": {
      "display_name": "CloudFront Distributions",
      "service": "cloudfront",
      "sdk_method": "list_distributions",
      "sdk_method_params": {},
      "response_path": "distributions",
      "id_field": "Id",
      "name_field": "DomainName",
      "is_global": true,
      "columns": [
        { "header": "DISTRIBUTION ID", "json_path": "Id", "width": 12 },
        { "header": "ALTERNATE DOMAINS", "json_path": "Aliases", "width": 28 },
        { "header": "ORIGINS", "json_path": "Origins", "width": 28 },
        { "header": "DOMAIN NAME", "json_path": "DomainName", "width": 18 },
        { "header": "STATUS", "json_path": "Status", "width": 9, "color_map": "state" },
        { "header": "ENABLED", "json_path": "Enabled", "width": 5 },
        { "header": "DESCRIPTION", "json_path": "Description", "width": 30, "visible": false },
        { "header": "PRICE CLASS", "json_path": "PriceClass", "width": 12, "visible": false },
        { "header": "SSL CERT", "json_path": "SslCertSource", "width": 10, "visible": false },
        { "header": "CERTIFICATE", "json_path": "Certificate", "width": 40, "visible": false },
        { "header": "LAST MODIFIED", "json_path": "LastModifiedTime", "width": 20, "visible": false },
        { "header": "HTTP VERSION", "json_path": "HttpVersion", "width": 8, "visible": false },
        { "header": "IPV6", "json_path": "Ipv6Enabled", "width": 5, "visible": false },
        { "header": "STAGING", "json_path": "Staging", "width": 5, "visible": false },
        { "header": "WEB ACL ID", "json_path": "WebACLId", "width": 30, "visible": false },
        { "header": "ARN", "json_path": "Arn", "width": 60, "visible": false }
      ],
      "sub_resources": [],
      "actions": [],
      "api_config": {
        "protocol": "rest-xml",
        "method": "GET",
        "path": "/2020-05-31/distribution",
        "response_root": "/DistributionList/Items/DistributionSummary",
        "pagination": {
          "input_token": "Marker",
          "output_token": "/DistributionList/NextMarker",
          "max_results_param": "MaxItems",
          "max_results": 100
        }
      },
      "field_mappings": {
        "Id": { "source": "/Id", "default": "-" },
        "DomainName": { "source": "/DomainName", "default": "-" },
        "Aliases": { "source": "/Aliases/Items/CNAME", "transform": "array_to_csv", "default": "-" },
        "Origins": {
          "source": "/Origins/Items/Origin/DomainName",
          "transform": "array_to_csv",
          "default": "-"
        },
        "Status": { "source": "/Status", "default": "-" },
        "Enabled": { "source": "/Enabled", "transform": "bool_to_yes_no" },
        "Description": { "source": "/Comment", "default": "-" },
        "PriceClass": { "source": "/PriceClass", "default": "-" },
        "SslCertSource": { "source": "/ViewerCertificate/CertificateSource", "default": "-" },
        "Certificate": { "source": "/ViewerCertificate/Certificate", "default": "-" },
        "LastModifiedTime": { "source": "/LastModifiedTime", "default": "-" },
        "HttpVersion": { "source": "/HttpVersion", "default": "-" },
        "Ipv6Enabled": { "source": "/IsIPV6Enabled", "transform": "bool_to_yes_no", "default": "-" },
        "Staging": { "source": "/Staging", "transform": "bool_to_yes_no", "default": "-" },
        "WebACLId": { "source": "/WebACLId", "default": "-" },
        "Arn": { "source": "/ARN", "default": "-" }
      }
    }
  }
}
