            "action": "GetMetricStatistics",
            "body": {
              "Namespace": "AWS/DocDB",
              "MetricName": "CPUUtilization",
              "Dimensions": [
                {
                  "Name": "DBInstanceIdentifier",
                  "Value": "{resource_id}"
                }
              ],
              "StartTime": "{epoch_now-15m}",
              "EndTime": "{epoch_now}",
