{
  "resources": {
    "acm-certificates": {
      "display_name": "ACM Certificates",
      "service": "acm",
      "sdk_method": "list_certificates",
      "sdk_method_params": {},
      "response_path": "certificates",
      "id_field": "CertificateArn",
      "name_field": "DomainName",
      "is_global": false,
      "columns": [
        { "header": "CERTIFICATE ID", "json_path": "CertificateArn", "width": 45, "locked": true },
        { "header": "COMMON NAME", "json_path": "DomainName", "width": 22 },
        { "header": "TYPE", "json_path": "Type", "width": 12 },
        { "header": "STATUS", "json_path": "Status", "width": 12, "color_map": "state" },
        { "header": "IN USE", "json_path": "InUse", "width": 8 },
        { "header": "RENEWAL ELIGIBILITY", "json_path": "RenewalEligibility", "width": 12 },
        { "header": "KEY ALGORITHM", "json_path": "KeyAlgorithm", "width": 12 },
        { "header": "DNS NAMES", "json_path": "SubjectAlternativeNameSummaries", "width": 22 },
        { "header": "KEY USAGE NAME", "json_path": "KeyUsages", "width": 18 },
        { "header": "EXT KEY USAGE NAME", "json_path": "ExtendedKeyUsages", "width": 22 },
        { "header": "CREATED AT", "json_path": "CreatedAt", "width": 18 },
        { "header": "ISSUED AT", "json_path": "IssuedAt", "width": 18 },
        { "header": "NOT BEFORE", "json_path": "NotBefore", "width": 18 },
        { "header": "NOT AFTER", "json_path": "NotAfter", "width": 18 },
        { "header": "REVOKED AT", "json_path": "RevokedAt", "width": 18 },
        { "header": "MANAGED BY", "json_path": "ManagedBy", "width": 12 },
        { "header": "IMPORTED AT", "json_path": "ImportedAt", "width": 18 },
        { "header": "IS EXPORTED", "json_path": "Exported", "width": 10 },
        { "header": "EXPORT OPTION", "json_path": "ExportOption", "width": 12 },
        { "header": "KEY SOURCE", "json_path": "CertificateKeyPairOrigin", "width": 14 }
      ],
      "sub_resources": [],
      "actions": [],
      "api_config": {
        "protocol": "json",
        "action": "ListCertificates",
        "response_root": "/CertificateSummaryList",
        "pagination": {
          "input_token": "NextToken",
          "output_token": "/NextToken",
          "max_results_param": "MaxItems",
          "max_results": 100
        }
      },
      "field_mappings": {
        "CertificateArn": { "source": "/CertificateArn", "default": "-" },
        "DomainName": { "source": "/DomainName", "default": "-" },
        "Status": { "source": "/Status", "default": "-" },
        "Type": { "source": "/Type", "default": "-" },
        "InUse": { "source": "/InUse", "transform": "bool_to_yes_no" },
        "RenewalEligibility": { "source": "/RenewalEligibility", "default": "-" },
        "KeyAlgorithm": { "source": "/KeyAlgorithm", "default": "-" },
        "SubjectAlternativeNameSummaries": { "source": "/SubjectAlternativeNameSummaries", "transform": "array_to_csv", "default": "-" },
        "KeyUsages": { "source": "/KeyUsages", "transform": "array_to_csv", "default": "-" },
        "ExtendedKeyUsages": { "source": "/ExtendedKeyUsages", "transform": "array_to_csv", "default": "-" },
        "CreatedAt": { "source": "/CreatedAt", "transform": "format_epoch_seconds", "default": "-" },
        "IssuedAt": { "source": "/IssuedAt", "transform": "format_epoch_seconds", "default": "-" },
        "NotBefore": { "source": "/NotBefore", "transform": "format_epoch_seconds", "default": "-" },
        "NotAfter": { "source": "/NotAfter", "transform": "format_epoch_seconds", "default": "-" },
        "RevokedAt": { "source": "/RevokedAt", "transform": "format_epoch_seconds", "default": "-" },
        "ManagedBy": { "source": "/ManagedBy", "default": "-" },
        "ImportedAt": { "source": "/ImportedAt", "transform": "format_epoch_seconds", "default": "-" },
        "Exported": { "source": "/Exported", "transform": "bool_to_yes_no" },
        "ExportOption": { "source": "/ExportOption", "default": "-" },
        "CertificateKeyPairOrigin": { "source": "/CertificateKeyPairOrigin", "default": "-" }
      },
      "describe_config": {
        "protocol": "json",
        "action": "DescribeCertificate",
        "id_param": "CertificateArn",
        "response_path": "/Certificate",
        "enrich_calls": [
          {
            "result_field": "Tags",
            "action": "ListTagsForCertificate",
            "body": { "CertificateArn": "{resource_id}" },
            "extract_path": "/Tags"
          }
        ],
        "describe_fields": [
          { "label": "Certificate ARN", "source": "/CertificateArn", "section": "Identity" },
          { "label": "Domain Name", "source": "/DomainName" },
          { "label": "Subject", "source": "/Subject" },
          { "label": "Issuer", "source": "/Issuer" },
          { "label": "Status", "source": "/Status" },
          { "label": "Type", "source": "/Type" },
          { "label": "Serial", "source": "/Serial" },
          { "label": "Key Algorithm", "source": "/KeyAlgorithm" },
          { "label": "Signature Alg", "source": "/SignatureAlgorithm" },
          { "label": "Key Pair Origin", "source": "/CertificateKeyPairOrigin" },
          { "label": "CA ARN", "source": "/CertificateAuthorityArn" },
          { "label": "Renewal Eligible", "source": "/RenewalEligibility" },

          { "label": "Subject Alt Names", "source": "/SubjectAlternativeNames", "section": "Domains", "list": true },

          { "label": "Validation", "source": "/DomainValidationOptions", "section": "Domain Validation", "list": true, "item_template": "{DomainName} [{ValidationStatus}] {ValidationMethod} {ResourceRecord/Type} {ResourceRecord/Name} => {ResourceRecord/Value}" },

          { "label": "Created At", "source": "/CreatedAt", "section": "Dates", "transform": "format_epoch_seconds" },
          { "label": "Issued At", "source": "/IssuedAt", "transform": "format_epoch_seconds" },
          { "label": "Not Before", "source": "/NotBefore", "transform": "format_epoch_seconds" },
          { "label": "Not After", "source": "/NotAfter", "transform": "format_epoch_seconds" },
          { "label": "Revoked At", "source": "/RevokedAt", "transform": "format_epoch_seconds" },
          { "label": "Revoke Reason", "source": "/RevocationReason" },

          { "label": "Used By", "source": "/InUseBy", "section": "In Use By", "list": true },

          { "label": "Renewal Status", "source": "/RenewalSummary/RenewalStatus", "section": "Renewal" },
          { "label": "Renewal Reason", "source": "/RenewalSummary/RenewalStatusReason" },
          { "label": "Renewed At", "source": "/RenewalSummary/UpdatedAt", "transform": "format_epoch_seconds" },

          { "label": "Key Usages", "source": "/KeyUsages", "section": "Key Usage", "list": true, "item_template": "{Name}" },
          { "label": "Ext Key Usages", "source": "/ExtendedKeyUsages", "list": true, "item_template": "{Name} ({OID})" },

          { "label": "Transparency", "source": "/Options/CertificateTransparencyLoggingPreference", "section": "Options" },
          { "label": "Export", "source": "/Options/Export" },

          { "label": "Tags", "source": "/Tags", "section": "Tags", "list": true, "item_template": "{Key}: {Value}" }
        ]
      }
    }
  }
}
