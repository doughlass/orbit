{
  "resources": {
    "autoscaling-groups": {
      "display_name": "Auto Scaling Groups",
      "service": "autoscaling",
      "sdk_method": "describe_auto_scaling_groups",
      "sdk_method_params": {},
      "response_path": "auto_scaling_groups",
      "id_field": "AutoScalingGroupName",
      "name_field": "AutoScalingGroupName",
      "is_global": false,
      "columns": [
        { "header": "GROUP NAME", "json_path": "AutoScalingGroupName", "width": 35 },
        { "header": "DESIRED", "json_path": "DesiredCapacity", "width": 10 },
        { "header": "MIN", "json_path": "MinSize", "width": 6 },
        { "header": "MAX", "json_path": "MaxSize", "width": 6 },
        { "header": "INSTANCES", "json_path": "InstanceCount", "width": 12 },
        { "header": "AZ", "json_path": "AvailabilityZones", "width": 20 }
      ],
      "sub_resources": [],
      "actions": [
        { "key": "ctrl+d", "display_name": "Delete Group", "shortcut": "ctrl+d", "sdk_method": "delete_auto_scaling_group", "confirm": { "message": "Delete Auto Scaling group", "default_yes": false, "destructive": true } }
      ],
      "api_config": {
        "protocol": "query",
        "action": "DescribeAutoScalingGroups",
        "response_root": "/DescribeAutoScalingGroupsResponse/DescribeAutoScalingGroupsResult/AutoScalingGroups/member",
        "pagination": {
          "input_token": "NextToken",
          "output_token": "/DescribeAutoScalingGroupsResponse/DescribeAutoScalingGroupsResult/NextToken",
          "max_results_param": "MaxRecords",
          "max_results": 100
        }
      },
      "field_mappings": {
        "Raw": { "source": "/" },
        "AutoScalingGroupName": { "source": "/AutoScalingGroupName", "default": "-" },
        "MinSize": { "source": "/MinSize", "default": "0" },
        "MaxSize": { "source": "/MaxSize", "default": "0" },
        "DesiredCapacity": { "source": "/DesiredCapacity", "default": "0" },
        "InstanceCount": { "source": "/Instances/member", "default": "0" },
        "AvailabilityZones": { "source": "/AvailabilityZones/member", "transform": "array_to_csv", "default": "-" }
      },
      "describe_from_row": true,
      "describe_config": {
        "describe_fields": [
          { "label": "Group Name", "source": "/Raw/AutoScalingGroupName", "section": "Details" },
          { "label": "ARN", "source": "/Raw/AutoScalingGroupARN", "section": "Details" },
          { "label": "Created", "source": "/Raw/CreatedTime", "section": "Details" },
          { "label": "Health Check", "source": "/Raw/HealthCheckType", "section": "Details" },
          { "label": "Grace Period", "source": "/Raw/HealthCheckGracePeriod", "section": "Details" },
          { "label": "Default Cooldown", "source": "/Raw/DefaultCooldown", "section": "Details" },
          { "label": "Desired", "source": "/Raw/DesiredCapacity", "section": "Capacity" },
          { "label": "Min", "source": "/Raw/MinSize", "section": "Capacity" },
          { "label": "Max", "source": "/Raw/MaxSize", "section": "Capacity" },
          { "label": "New Instances Scale-In Protected", "source": "/Raw/NewInstancesProtectedFromScaleIn", "transform": "bool_to_yes_no", "section": "Capacity" },
          { "label": "Launch Template", "source": "/Raw/LaunchTemplate/LaunchTemplateName", "section": "Launch" },
          { "label": "Launch Template Version", "source": "/Raw/LaunchTemplate/Version", "section": "Launch" },
          { "label": "Launch Config", "source": "/Raw/LaunchConfigurationName", "section": "Launch" },
          { "label": "Availability Zones", "source": "/Raw/AvailabilityZones/member", "transform": "array_to_csv", "section": "Networking" },
          { "label": "Subnets", "source": "/Raw/VPCZoneIdentifier", "section": "Networking" },
          { "label": "Instances", "source": "/Raw/Instances/member", "list": true, "item_template": "{InstanceId} {LifecycleState} {InstanceType} {AvailabilityZone}", "section": "Instances" },
          { "label": "Traffic Sources", "source": "/Raw/TrafficSources/member", "list": true, "item_template": "{Type} {Identifier}", "section": "Traffic" },
          { "label": "Suspended Processes", "source": "/Raw/SuspendedProcesses/member", "list": true, "item_template": "{ProcessName}", "section": "Health" },
          { "label": "Termination Policies", "source": "/Raw/TerminationPolicies/member", "list": true, "section": "Health" },
          { "label": "Enabled Metrics", "source": "/Raw/EnabledMetrics/member", "list": true, "item_template": "{Metric} ({Granularity})", "section": "Health" },
          { "label": "Tags", "source": "/Raw/Tags/member", "list": true, "item_template": "{key}={value}", "section": "Tags" }
        ]
      },
      "action_configs": {
        "delete_auto_scaling_group": {
          "action_id": "delete_auto_scaling_group",
          "protocol": "query",
          "action": "DeleteAutoScalingGroup",
          "id_param": "AutoScalingGroupName",
          "static_params": {
            "ForceDelete": "true"
          }
        }
      }
    }
  }
}
