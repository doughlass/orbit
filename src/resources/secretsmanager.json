{
  "resources": {
    "secretsmanager-secrets": {
      "display_name": "Secrets Manager Secrets",
      "service": "secretsmanager",
      "sdk_method": "list_secrets",
      "sdk_method_params": {},
      "response_path": "secrets",
      "id_field": "ARN",
      "name_field": "Name",
      "is_global": false,
      "columns": [
        { "header": "SECRET NAME", "json_path": "Name", "width": 40, "locked": true },
        { "header": "DESCRIPTION", "json_path": "Description", "width": 30 },
        { "header": "LAST RETRIEVED", "json_path": "LastAccessedDate", "width": 22 },
        { "header": "CREATED ON", "json_path": "CreatedDate", "width": 22 },
        { "header": "DELETED ON", "json_path": "DeletedDate", "width": 22, "visible": false },
        { "header": "LAST UPDATED", "json_path": "LastChangedDate", "width": 22, "visible": false },
        { "header": "LAST ROTATED", "json_path": "LastRotatedDate", "width": 22, "visible": false },
        { "header": "NEXT ROTATION", "json_path": "NextRotationDate", "width": 22, "visible": false },
        { "header": "MANAGED BY", "json_path": "OwningService", "width": 16, "visible": false },
        { "header": "TYPE", "json_path": "Type", "width": 14, "visible": false }
      ],
      "sub_resources": [],
      "actions": [
        { "key": "R", "display_name": "Rotate Secret", "shortcut": "R", "sdk_method": "rotate_secret", "confirm": { "message": "Rotate secret", "default_yes": false } },
        { "key": "ctrl+d", "display_name": "Delete Secret", "shortcut": "ctrl+d", "sdk_method": "delete_secret", "confirm": { "message": "Delete secret", "default_yes": false, "destructive": true } }
      ],

      "api_config": {
        "protocol": "json",
        "action": "ListSecrets",
        "response_root": "/SecretList",
        "static_params": {
          "MaxResults": 100
        },
        "pagination": {
          "input_token": "NextToken",
          "output_token": "/NextToken"
        }
      },
      "field_mappings": {
        "Name": { "source": "/Name", "default": "-" },
        "ARN": { "source": "/ARN", "default": "-" },
        "Description": { "source": "/Description", "default": "-" },
        "LastAccessedDate": { "source": "/LastAccessedDate", "transform": "format_epoch_seconds", "default": "-" },
        "LastChangedDate": { "source": "/LastChangedDate", "transform": "format_epoch_seconds", "default": "-" },
        "CreatedDate": { "source": "/CreatedDate", "transform": "format_epoch_seconds", "default": "-" },
        "DeletedDate": { "source": "/DeletedDate", "transform": "format_epoch_seconds", "default": "-" },
        "LastRotatedDate": { "source": "/LastRotatedDate", "transform": "format_epoch_seconds", "default": "-" },
        "NextRotationDate": { "source": "/NextRotationDate", "transform": "format_epoch_seconds", "default": "-" },
        "OwningService": { "source": "/OwningService", "default": "-" },
        "Type": { "source": "/Type", "default": "-" }
      },
      "action_configs": {
        "delete_secret": {
          "action_id": "delete_secret",
          "protocol": "json",
          "action": "DeleteSecret",
          "body_template": "{\"SecretId\": \"{resource_id}\", \"ForceDeleteWithoutRecovery\": true}"
        },
        "rotate_secret": {
          "action_id": "rotate_secret",
          "protocol": "json",
          "action": "RotateSecret",
          "body_template": "{\"SecretId\": \"{resource_id}\"}"
        }
      },
      "describe_config": {
        "protocol": "json",
        "action": "DescribeSecret",
        "body_template": "{\"SecretId\": \"{resource_id}\"}",
        "describe_fields": [
          { "label": "Secret Name", "source": "/Name", "section": "Summary" },
          { "label": "ARN", "source": "/ARN" },
          { "label": "Description", "source": "/Description" },
          { "label": "Type", "source": "/Type" },
          { "label": "Managed By", "source": "/OwningService" },
          { "label": "KMS Key", "source": "/KmsKeyId" },
          { "label": "Primary Region", "source": "/PrimaryRegion" },

          { "label": "Created", "source": "/CreatedDate", "section": "Dates", "transform": "format_epoch_seconds" },
          { "label": "Last Retrieved", "source": "/LastAccessedDate", "transform": "format_epoch_seconds" },
          { "label": "Last Updated", "source": "/LastChangedDate", "transform": "format_epoch_seconds" },
          { "label": "Deleted", "source": "/DeletedDate", "transform": "format_epoch_seconds" },

          { "label": "Rotation Enabled", "source": "/RotationEnabled", "section": "Rotation" },
          { "label": "Last Rotated", "source": "/LastRotatedDate", "transform": "format_epoch_seconds" },
          { "label": "Next Rotation", "source": "/NextRotationDate", "transform": "format_epoch_seconds" },
          { "label": "Rotation Lambda", "source": "/RotationLambdaARN" },

          { "label": "Tags", "source": "/Tags", "section": "Tags", "list": true, "item_template": "{Key}: {Value}" }
        ]
      }
    }
  }
}
