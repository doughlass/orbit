{
  "resources": {
    "lambda-functions": {
      "display_name": "Lambda Functions",
      "service": "lambda",
      "sdk_method": "list_functions",
      "sdk_method_params": {},
      "response_path": "functions",
      "id_field": "FunctionName",
      "name_field": "FunctionName",
      "is_global": false,
      "columns": [
        { "header": "FUNCTION NAME", "json_path": "FunctionName", "width": 30 },
        { "header": "DESCRIPTION", "json_path": "Description", "width": 25, "visible": false },
        { "header": "RUNTIME", "json_path": "Runtime", "width": 12 },
        { "header": "PACKAGE TYPE", "json_path": "PackageType", "width": 10, "visible": false },
        { "header": "ARCHITECTURE", "json_path": "Architectures", "width": 14, "visible": false },
        { "header": "CODE SIZE", "json_path": "CodeSize", "width": 10, "visible": false },
        { "header": "MEMORY", "json_path": "MemorySize", "width": 10 },
        { "header": "TIMEOUT", "json_path": "Timeout", "width": 10 },
        { "header": "STATE", "json_path": "State", "width": 10, "color_map": "state" },
        { "header": "HANDLER", "json_path": "Handler", "width": 20, "visible": false },
        { "header": "ROLE", "json_path": "Role", "width": 40, "visible": false },
        { "header": "VERSION", "json_path": "Version", "width": 10, "visible": false },
        { "header": "MODIFIED", "json_path": "LastModified", "width": 25 }
      ],
      "sub_resources": [
        { "shortcut": "a", "display_name": "Aliases", "resource_key": "lambda-aliases", "parent_id_field": "FunctionName", "filter_param": "functionName" },
        { "shortcut": "v", "display_name": "Versions", "resource_key": "lambda-versions", "parent_id_field": "FunctionName", "filter_param": "functionName" }
      ],
      "actions": [
        { "key": "i", "display_name": "Invoke", "shortcut": "i", "sdk_method": "invoke_function", "confirm": { "message": "Invoke Lambda function", "default_yes": true } },
        { "key": "ctrl+d", "display_name": "Delete", "shortcut": "ctrl+d", "sdk_method": "delete_function", "confirm": { "message": "Delete Lambda function", "default_yes": false, "destructive": true } }
      ],

      "api_config": {
        "protocol": "rest-json",
        "method": "GET",
        "path": "/2015-03-31/functions",
        "response_root": "/Functions",
        "pagination": {
          "input_token": "Marker",
          "output_token": "/NextMarker",
          "max_results_param": "MaxItems",
          "max_results": 50
        }
      },
      "field_mappings": {
        "FunctionName": { "source": "/FunctionName", "default": "-" },
        "Description": { "source": "/Description", "default": "-" },
        "Runtime": { "source": "/Runtime", "default": "-" },
        "PackageType": { "source": "/PackageType", "default": "-" },
        "Architectures": { "source": "/Architectures", "transform": "array_to_csv", "default": "-" },
        "CodeSize": { "source": "/CodeSize", "transform": "format_bytes", "default": "-" },
        "MemorySize": { "source": "/MemorySize", "default": "0" },
        "Timeout": { "source": "/Timeout", "default": "-" },
        "State": { "source": "/State", "default": "-" },
        "Handler": { "source": "/Handler", "default": "-" },
        "Role": { "source": "/Role", "default": "-" },
        "Version": { "source": "/Version", "default": "-" },
        "LastModified": { "source": "/LastModified", "transform": "format_epoch_seconds", "default": "-" }
      },
      "action_configs": {
        "invoke_function": {
          "action_id": "invoke_function",
          "protocol": "rest-json",
          "method": "POST",
          "path": "/2015-03-31/functions/{resource_id}/invocations",
          "body_template": "{}"
        },
        "delete_function": {
          "action_id": "delete_function",
          "protocol": "rest-json",
          "method": "DELETE",
          "path": "/2015-03-31/functions/{resource_id}"
        }
      },
      "describe_config": {
        "protocol": "rest-json",
        "method": "GET",
        "path": "/2015-03-31/functions/{resource_id}",
        "response_path": "/Configuration",
        "enrich_calls": [
          {
            "result_field": "EventSourceMappings",
            "path": "/2015-03-31/event-source-mappings?FunctionName={resource_id}",
            "method": "GET",
            "extract_path": "/EventSourceMappings"
          },
          {
            "result_field": "EventBridgeRules",
            "service_name": "events",
            "protocol": "json",
            "target": "ListRuleNamesByTarget",
            "body_template": "{\"TargetArn\":\"{FunctionArn}\"}",
            "extract_path": "/RuleNames"
          }
        ],
        "overview": {
          "title_source": "/FunctionName",
          "subtitle_source": "/Description",
          "chips": [
            { "label": "Runtime",  "source": "/Runtime" },
            { "label": "Arch",     "source": "/Architectures", "transform": "array_to_csv" },
            { "label": "Package",  "source": "/PackageType" },
            { "label": "State",    "source": "/State" },
            { "label": "Size",     "source": "/CodeSize", "transform": "format_bytes" }
          ],
          "resources": [
            { "label": "EVENT SOURCE MAPPINGS", "source": "/EventSourceMappings", "item_template": "{EventSourceArn}" },
            { "label": "EVENTBRIDGE RULES", "source": "/EventBridgeRules" }
          ]
        },
        "describe_fields": [
          { "label": "Function Name",    "source": "/FunctionName", "section": "Identity" },
          { "label": "ARN",              "source": "/FunctionArn" },
          { "label": "Description",      "source": "/Description" },
          { "label": "State",            "source": "/State" },
          { "label": "Last Update",      "source": "/LastUpdateStatus" },
          { "label": "State Reason",     "source": "/StateReason" },

          { "label": "Runtime",          "source": "/Runtime", "section": "Configuration" },
          { "label": "Handler",          "source": "/Handler" },
          { "label": "Role",             "source": "/Role" },
          { "label": "Package Type",     "source": "/PackageType" },
          { "label": "Architectures",    "source": "/Architectures", "transform": "array_to_csv" },
          { "label": "Memory",           "source": "/MemorySize" },
          { "label": "Timeout",          "source": "/Timeout" },
          { "label": "Code Size",        "source": "/CodeSize", "transform": "format_bytes" },
          { "label": "Ephemeral Storage","source": "/EphemeralStorage/Size" },
          { "label": "Signing",          "source": "/SigningJobArn" },
          { "label": "Version",          "source": "/Version" },
          { "label": "Revision",         "source": "/RevisionId" },

          { "label": "Tracing Mode",     "source": "/TracingConfig/Mode", "section": "Monitoring" },
          { "label": "Log Format",       "source": "/LoggingConfig/LogFormat" },
          { "label": "Application Level", "source": "/LoggingConfig/ApplicationLogLevel" },
          { "label": "System Level",     "source": "/LoggingConfig/SystemLogLevel" },
          { "label": "Log Group",        "source": "/LoggingConfig/LogGroup" },

          { "label": "VPC ID",           "source": "/VpcConfig/VpcId", "section": "Network" },
          { "label": "Subnets",          "source": "/VpcConfig/SubnetIds", "transform": "array_to_csv" },
          { "label": "Security Groups",  "source": "/VpcConfig/SecurityGroupIds", "transform": "array_to_csv" },
          { "label": "Public IPv6",      "source": "/VpcConfig/Ipv6AllowedForDualStack", "transform": "bool_to_yes_no" },

          { "label": "Variables",        "source": "/Environment/Variables", "section": "Environment" },

          { "label": "SnapStart",        "source": "/SnapStart/ApplyOn", "section": "SnapStart" },
          { "label": "Optimization",     "source": "/SnapStart/OptimizationStatus" },

          { "label": "Last Modified",    "source": "/LastModified", "transform": "format_epoch_seconds", "section": "Dates" },
          { "label": "Created",          "source": "/LastModified", "transform": "format_epoch_seconds" }
        ]
      }
    },
    "lambda-layers": {
      "display_name": "Lambda Layers",
      "service": "lambda",
      "sdk_method": "list_layers",
      "sdk_method_params": {},
      "response_path": "layers",
      "id_field": "LayerName",
      "name_field": "LayerName",
      "is_global": false,
      "columns": [
        { "header": "LAYER NAME", "json_path": "LayerName", "width": 30 },
        { "header": "VERSION", "json_path": "Version", "width": 8 },
        { "header": "RUNTIMES", "json_path": "CompatibleRuntimes", "width": 30 },
        { "header": "CREATED", "json_path": "CreatedDate", "width": 20 }
      ],
      "sub_resources": [],
      "actions": [],
      "api_config": {
        "protocol": "rest-json",
        "method": "GET",
        "path": "/2018-10-31/layers",
        "response_root": "/Layers",
        "pagination": {
          "input_token": "Marker",
          "output_token": "/NextMarker",
          "max_results_param": "MaxItems",
          "max_results": 50
        }
      },
      "field_mappings": {
        "LayerName": { "source": "/LayerName", "default": "-" },
        "LayerArn": { "source": "/LayerArn", "default": "-" },
        "Version": { "source": "/LatestMatchingVersion/Version", "default": "0" },
        "Description": { "source": "/LatestMatchingVersion/Description", "default": "-" },
        "CreatedDate": { "source": "/LatestMatchingVersion/CreatedDate", "transform": "format_epoch_seconds", "default": "-" },
        "LicenseInfo": { "source": "/LatestMatchingVersion/LicenseInfo", "default": "-" },
        "CompatibleRuntimes": { "source": "/LatestMatchingVersion/CompatibleRuntimes", "transform": "array_to_csv", "default": "-" }
      }
    },
    "lambda-aliases": {
      "display_name": "Lambda Aliases",
      "service": "lambda",
      "sdk_method": "list_aliases",
      "sdk_method_params": {},
      "response_path": "aliases",
      "id_field": "Name",
      "name_field": "Name",
      "is_global": false,
      "requires_parent": true,
      "columns": [
        { "header": "ALIAS NAME", "json_path": "Name", "width": 30 },
        { "header": "VERSION", "json_path": "FunctionVersion", "width": 12 },
        { "header": "DESCRIPTION", "json_path": "Description", "width": 40 }
      ],
      "sub_resources": [],
      "actions": [],
      "api_config": {
        "protocol": "rest-json",
        "method": "GET",
        "path": "/2015-03-31/functions/{functionName}/aliases",
        "response_root": "/Aliases",
        "pagination": {
          "input_token": "Marker",
          "output_token": "/NextMarker",
          "max_results_param": "MaxItems",
          "max_results": 50
        }
      },
      "field_mappings": {
        "Name": { "source": "/Name", "default": "-" },
        "AliasArn": { "source": "/AliasArn", "default": "-" },
        "FunctionVersion": { "source": "/FunctionVersion", "default": "-" },
        "Description": { "source": "/Description", "default": "-" }
      }
    },
    "lambda-versions": {
      "display_name": "Lambda Versions",
      "service": "lambda",
      "sdk_method": "list_versions_by_function",
      "sdk_method_params": {},
      "response_path": "versions",
      "id_field": "Version",
      "name_field": "Version",
      "is_global": false,
      "requires_parent": true,
      "columns": [
        { "header": "VERSION", "json_path": "Version", "width": 10 },
        { "header": "STATE", "json_path": "State", "width": 14, "color_map": "state" },
        { "header": "RUNTIME", "json_path": "Runtime", "width": 14 },
        { "header": "MODIFIED", "json_path": "LastModified", "width": 25 }
      ],
      "sub_resources": [],
      "actions": [],
      "api_config": {
        "protocol": "rest-json",
        "method": "GET",
        "path": "/2015-03-31/functions/{functionName}/versions",
        "response_root": "/Versions",
        "pagination": {
          "input_token": "Marker",
          "output_token": "/NextMarker",
          "max_results_param": "MaxItems",
          "max_results": 50
        }
      },
      "field_mappings": {
        "Version": { "source": "/Version", "default": "-" },
        "FunctionName": { "source": "/FunctionName", "default": "-" },
        "State": { "source": "/State", "default": "-" },
        "Runtime": { "source": "/Runtime", "default": "-" },
        "MemorySize": { "source": "/MemorySize", "default": "0" },
        "LastModified": { "source": "/LastModified", "transform": "format_epoch_seconds", "default": "-" }
      }
    }
  }
}
