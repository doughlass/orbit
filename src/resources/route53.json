{
  "resources": {
    "route53-hosted-zones": {
      "display_name": "Route53 Hosted Zones",
      "service": "route53",
      "sdk_method": "list_hosted_zones",
      "sdk_method_params": {},
      "response_path": "hosted_zones",
      "id_field": "Id",
      "name_field": "Name",
      "is_global": true,
      "columns": [
        { "header": "ZONE NAME", "json_path": "Name", "width": 40 },
        { "header": "ZONE ID", "json_path": "Id", "width": 30 },
        { "header": "TYPE", "json_path": "Config.PrivateZone", "width": 12 },
        { "header": "RECORD COUNT", "json_path": "ResourceRecordSetCount", "width": 15 }
      ],
      "enter_sub_resource": "route53-records",
      "sub_resources": [
        { "shortcut": "r", "display_name": "Records", "resource_key": "route53-records", "parent_id_field": "Id", "filter_param": "hosted_zone_id" }
      ],
      "actions": [],
      "api_config": {
        "protocol": "rest-xml",
        "method": "GET",
        "path": "/2013-04-01/hostedzone",
        "response_root": "/ListHostedZonesResponse/HostedZones/HostedZone",
        "pagination": {
          "input_token": "marker",
          "output_token": "/ListHostedZonesResponse/NextMarker",
          "max_results_param": "maxitems",
          "max_results": 100
        }
      },
      "field_mappings": {
        "Id": { "source": "/Id", "default": "-" },
        "Name": { "source": "/Name", "default": "-" },
        "ResourceRecordSetCount": { "source": "/ResourceRecordSetCount", "default": "0" },
        "Config.PrivateZone": { "source": "/Config/PrivateZone", "transform": "private_zone_to_type" }
      }
    },
    "route53-records": {
      "display_name": "Route53 Records",
      "service": "route53",
      "sdk_method": "list_resource_record_sets",
      "sdk_method_params": {},
      "response_path": "resource_record_sets",
      "id_field": "RecordId",
      "name_field": "Name",
      "is_global": true,
      "requires_parent": true,
      "columns": [
        { "header": "NAME", "json_path": "Name", "width": 50 },
        { "header": "TYPE", "json_path": "Type", "width": 10 },
        { "header": "TTL", "json_path": "TTL", "width": 8 },
        { "header": "VALUE", "json_path": "Value", "width": 60 }
      ],
      "sub_resources": [],
      "actions": [],
      "api_config": {
        "protocol": "rest-xml",
        "method": "GET",
        "path": "/2013-04-01{hosted_zone_id}/rrset",
        "response_root": "/ListResourceRecordSetsResponse/ResourceRecordSets/ResourceRecordSet",
        "pagination": {
          "multi_token": [
            { "query_param": "name", "response_path": "/ListResourceRecordSetsResponse/NextRecordName" },
            { "query_param": "type", "response_path": "/ListResourceRecordSetsResponse/NextRecordType" }
          ],
          "max_results_param": "maxitems",
          "max_results": 100
        }
      },
      "field_mappings": {
        "RecordId": { "source": "/", "transform": "route53_record_id" },
        "Name": { "source": "/Name", "default": "-" },
        "Type": { "source": "/Type", "default": "-" },
        "TTL": { "source": "/TTL", "default": "-" },
        "Value": { "source": "/", "transform": "route53_record_value" },
        "Raw": { "source": "/" }
      },
      "describe_from_row": true,
      "describe_config": {
        "describe_fields": [
          { "label": "Name", "source": "/Raw/Name", "section": "Record" },
          { "label": "Type", "source": "/Raw/Type", "section": "Record" },
          { "label": "Alias", "source": "/Raw", "transform": "route53_is_alias", "section": "Record" },
          { "label": "TTL", "source": "/Raw/TTL", "section": "Record" },

          { "label": "Routing Policy", "source": "/Raw", "transform": "route53_routing_policy", "section": "Routing Policy" },
          { "label": "Set ID", "source": "/Raw/SetIdentifier", "section": "Routing Policy" },
          { "label": "Weight", "source": "/Raw/Weight", "section": "Routing Policy" },
          { "label": "Region", "source": "/Raw/Region", "section": "Routing Policy" },
          { "label": "Failover", "source": "/Raw/Failover", "section": "Routing Policy" },
          { "label": "Multi-Value", "source": "/Raw/MultiValueAnswer", "transform": "bool_to_yes_no", "section": "Routing Policy" },
          { "label": "Health Check", "source": "/Raw/HealthCheckId", "section": "Routing Policy" },
          { "label": "Traffic Policy ID", "source": "/Raw/TrafficPolicyInstanceId", "section": "Routing Policy" },

          { "label": "Alias DNS", "source": "/Raw/AliasTarget/DNSName", "section": "Alias Target" },
          { "label": "Alias Zone ID", "source": "/Raw/AliasTarget/HostedZoneId", "section": "Alias Target" },
          { "label": "Alias Health", "source": "/Raw/AliasTarget/EvaluateTargetHealth", "transform": "bool_to_yes_no", "section": "Alias Target" },

          { "label": "Continent", "source": "/Raw/GeoLocation/ContinentCode", "section": "Geo Location" },
          { "label": "Country", "source": "/Raw/GeoLocation/CountryCode", "section": "Geo Location" },
          { "label": "Subdivision", "source": "/Raw/GeoLocation/SubdivisionCode", "section": "Geo Location" },

          { "label": "CIDR Collection", "source": "/Raw/CidrRoutingConfig/CollectionId", "section": "CIDR Routing" },
          { "label": "CIDR Location", "source": "/Raw/CidrRoutingConfig/LocationName", "section": "CIDR Routing" },

          { "label": "Values", "source": "/Raw/ResourceRecords/ResourceRecord", "list": true, "item_template": "{Value}" }
        ]
      }
    }
  }
}
