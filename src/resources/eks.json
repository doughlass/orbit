{
  "resources": {
    "eks-clusters": {
      "display_name": "EKS Clusters",
      "service": "eks",
      "sdk_method": "list_clusters",
      "sdk_method_params": {},
      "response_path": "clusters",
      "id_field": "name",
      "name_field": "name",
      "is_global": false,
      "columns": [
        { "header": "CLUSTER NAME", "json_path": "name", "width": 50 }
      ],
      "enter_sub_resource": "eks-nodegroups",
      "sub_resources": [
        { "shortcut": "n", "display_name": "Node Groups", "resource_key": "eks-nodegroups", "parent_id_field": "name", "filter_param": "name" },
        { "shortcut": "f", "display_name": "Fargate Profiles", "resource_key": "eks-fargate-profiles", "parent_id_field": "name", "filter_param": "name" },
        { "shortcut": "a", "display_name": "Add-ons", "resource_key": "eks-addons", "parent_id_field": "name", "filter_param": "name" },
        { "shortcut": "u", "display_name": "Updates", "resource_key": "eks-updates", "parent_id_field": "name", "filter_param": "name" }
      ],
      "actions": [
        { "key": "ctrl+d", "display_name": "Delete Cluster", "shortcut": "ctrl+d", "sdk_method": "delete_cluster", "confirm": { "message": "Delete EKS cluster", "default_yes": false, "destructive": true } }
      ],
      "api_config": {
        "protocol": "rest-json",
        "method": "GET",
        "path": "/clusters",
        "response_root": "/clusters",
        "pagination": {
          "input_token": "nextToken",
          "output_token": "/nextToken",
          "max_results_param": "maxResults",
          "max_results": 100
        }
      },
      "field_mappings": {
        "name": { "source": "", "default": "-" }
      },
      "action_configs": {
        "delete_cluster": {
          "action_id": "delete_cluster",
          "protocol": "rest-json",
          "method": "DELETE",
          "path": "/clusters/{resource_id}"
        }
      },
      "describe_config": {
        "protocol": "rest-json",
        "method": "GET",
        "path": "/clusters/{resource_id}",
        "response_path": "/cluster",
        "describe_fields": [
          { "label": "Status",           "source": "/status" },
          { "label": "Version",          "source": "/version" },
          { "label": "Platform",         "source": "/platformVersion" },
          { "label": "ARN",              "source": "/arn" },
          { "label": "Endpoint",         "source": "/endpoint" },
          { "label": "Role ARN",         "source": "/roleArn" },
          { "label": "Service CIDR",     "source": "/kubernetesNetworkConfig/serviceIpv4Cidr" },
          { "label": "IP Family",        "source": "/kubernetesNetworkConfig/ipFamily" },
          { "label": "VPC Subnets",      "source": "/resourcesVpcConfig/subnetIds", "transform": "array_to_csv" },
          { "label": "Security Groups",   "source": "/resourcesVpcConfig/securityGroupIds", "transform": "array_to_csv" },
          { "label": "Public Endpoint",  "source": "/resourcesVpcConfig/endpointPublicAccess", "transform": "bool_to_yes_no" },
          { "label": "Private Endpoint", "source": "/resourcesVpcConfig/endpointPrivateAccess", "transform": "bool_to_yes_no" },
          { "label": "OIDC Issuer",      "source": "/identity/oidc/issuer" },
          { "label": "Auth Mode",        "source": "/accessConfig/authenticationMode" },
          { "label": "Log Types",        "source": "/logging/clusterLogging" },
          { "label": "Health Issues",    "source": "/health/issues" },
          { "label": "Created",          "source": "/createdAt", "transform": "format_epoch_seconds" }
        ]
      }
    },
